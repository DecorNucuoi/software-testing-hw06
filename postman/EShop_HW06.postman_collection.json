  "item": [
    {
      "name": "API1-FR06-ProductDetail",
      "item": [
        {
          "name": "TC-API1-SMOKE-001 | GET product 1 tra ve 200 + schema dung",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('Co truong id, name, price', () => {",
                  "  pm.expect(b).to.have.property('id');",
                  "  pm.expect(b).to.have.property('name');",
                  "  pm.expect(b).to.have.property('price');",
                  "});",
                  "pm.test('price phai la kieu number (schema)', () => {",
                  "  pm.expect(b.price).to.be.a('number');",
                  "});",
                  "pm.test('Response < 2000ms', () => pm.expect(pm.response.responseTime).to.be.below(2000));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "1"]
            }
          }
        },
        {
          "name": "TC-API1-SMOKE-002 | GET product id khong ton tai",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Theo spec, id khong ton tai nen tra 404. Ghi nhan neu SUT tra khac.",
                  "pm.test('Khong tra ve 500', () => pm.expect(pm.response.code).to.not.equal(500));",
                  "console.log('[FR06] GET /products/999999 -> status', pm.response.code);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/999999",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "999999"]
            }
          }
        }
      ]
