    {
      "name": "API2-FR09-Coupon",
      "item": [
        {
          "name": "SETUP | Login user (luu userToken + userId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "if (b.token) { pm.collectionVariables.set('userToken', b.token); pm.environment.set('userToken', b.token); }",
                  "if (b.user && b.user.id) { pm.environment.set('userId', b.user.id); }",
                  "console.log('[SETUP] userToken saved:', !!b.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "login"]
            }
          }
        },
        {
          "name": "TC-API2-SMOKE-001 | Apply SAVE10 du nguong (>=300k)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('Co discount_amount va final_amount', () => {",
                  "  pm.expect(b).to.have.property('discount_amount');",
                  "  pm.expect(b).to.have.property('final_amount');",
                  "});",
                  "// SAVE10 = percent 10%, total 500000 -> discount ky vong 50000 theo spec",
                  "pm.test('[SPEC] discount = 10% cua 500000 = 50000', () => {",
                  "  pm.expect(b.discount_amount).to.eql(50000);",
                  "});",
                  "console.log('[FR09] discount_amount =', b.discount_amount, '(spec expect 50000)');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"SAVE10\",\n  \"total_amount\": 500000,\n  \"user_id\": {{userId}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/apply-coupon",
              "host": ["{{baseUrl}}"],
              "path": ["api", "apply-coupon"]
            }
          }
        },
        {
          "name": "TC-API2-SMOKE-002 | Ma EXPIRED phai bi tu choi",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// EXPIRED da het han 2020 -> spec doi bi tu choi (400).",
                  "pm.test('[SPEC] Ma het han khong duoc ap dung (khong 200 kem discount)', () => {",
                  "  const b = pm.response.json();",
                  "  const applied = pm.response.code === 200 && b.discount_amount;",
                  "  pm.expect(applied, 'ma het han ma van ap dung => BUG').to.not.be.ok;",
                  "});",
                  "console.log('[FR09] EXPIRED -> status', pm.response.code);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"EXPIRED\",\n  \"total_amount\": 500000,\n  \"user_id\": {{userId}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/apply-coupon",
              "host": ["{{baseUrl}}"],
              "path": ["api", "apply-coupon"]
            }
          }
        }
      ]
    },
